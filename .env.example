# Supabase
NEXT_PUBLIC_SUPABASE_URL=your-project-url.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Webhook (N8N) — order notifications
# Remove the fallback URL from route.ts once this is set
N8N_WEBHOOK_URL=https://n8n.vladkuzmenko.com/webhook/jl-website

# Site canonical URL — used for sitemap, robots.txt, canonical, hreflang
# Set to your REAL production domain (no trailing slash).
# In Vercel: Dashboard → Project → Settings → Environment Variables → Production only.
# Alternatively set SITE_URL (server-only, no NEXT_PUBLIC_ prefix) for the same effect.
# If neither is set, getSiteUrl() falls back to VERCEL_PROJECT_PRODUCTION_URL (auto-detected).
NEXT_PUBLIC_SITE_URL=https://your-production-domain.com

# Analytics — both are optional; scripts are skipped if not set
# GA4 Measurement ID (e.g. G-XXXXXXXXXX)
NEXT_PUBLIC_GA_ID=

# Meta Pixel ID (numeric, e.g. 1234567890123)
NEXT_PUBLIC_META_PIXEL_ID=
